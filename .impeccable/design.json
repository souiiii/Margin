    {
      "name": "Empty State",
      "kind": "custom",
      "description": "A signature heading and short explanation, with the asymmetric medallion.",
      "html": "<section class=\"ds-empty\"><div class=\"ds-empty-symbol\" aria-hidden=\"true\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z\"/></svg></div><h2 class=\"ds-empty-title\">A place for your reading</h2><p class=\"ds-empty-copy\">Bring a passage you want to spend time with.</p></section>",
      "css": ".ds-empty{display:flex;flex-direction:column;align-items:center;text-align:center;padding:68px 24px 76px;max-width:530px;margin:0 auto}.ds-empty-symbol{display:flex;align-items:center;justify-content:center;width:76px;height:80px;background:var(--accent-soft,#e5f1ef);color:var(--accent,#287e87);border-radius:40px 40px 25px 25px;margin-bottom:25px;position:relative}.ds-empty-symbol:after{content:\"\";width:12px;height:12px;background:var(--peach,#ffe0c8);border-radius:50%;position:absolute;bottom:5px;right:-3px}.ds-empty-title{font:700 25px/1.35 var(--signature,\"Anonymous Pro\",monospace);letter-spacing:-.015em;color:var(--ink,#173d42);margin:0 0 12px}.ds-empty-copy{font:400 13px/1.7 var(--ui,\"Inter\",sans-serif);color:var(--muted,#5b6f71);max-width:390px;margin:0 0 24px}"
    }
