      "css": ".ds-field-label{display:flex;flex-direction:column;gap:7px;color:var(--text,#28464a);font:500 13px/1.6 var(--ui,\"Inter\",sans-serif)}.ds-field{border:1px solid var(--line,#dce3df);border-radius:7px;background:var(--paper,#fff);color:var(--text,#28464a);padding:10px 12px;min-width:0;font:400 14px/1.6 var(--ui,\"Inter\",sans-serif);caret-color:var(--accent,#287e87);transition:border-color 160ms,box-shadow 160ms}.ds-field::placeholder{color:var(--muted,#5b6f71);opacity:1}.ds-field:hover{border-color:var(--muted,#5b6f71)}.ds-field:focus{border-color:var(--accent,#287e87);box-shadow:0 0 0 3px var(--accent-soft,#e5f1ef);outline:none}@media(prefers-reduced-motion:reduce){.ds-field{transition:none}}"
