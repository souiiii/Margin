      "description": "The compact floating controls paired with peach prose annotations.",
      "html": "<div class=\"ds-selection\" role=\"toolbar\" aria-label=\"Selected reading text\"><button class=\"ds-selection-button\">Highlight</button><button class=\"ds-selection-button\">Collect</button></div>",
      "css": ".ds-selection{display:inline-flex;align-items:center;padding:4px;background:var(--ink,#173d42);color:var(--paper,#fff);border-radius:7px;box-shadow:var(--shadow,0 8px 32px #173d4214);max-width:calc(100vw - 24px)}.ds-selection-button{display:flex;align-items:center;gap:7px;padding:8px 10px;border:0;background:none;color:inherit;font:400 11px/1.6 var(--ui,\"Inter\",sans-serif);border-radius:4px;cursor:pointer;transition:background-color 160ms var(--ease,cubic-bezier(0.16,1,0.3,1)),color 160ms var(--ease,cubic-bezier(0.16,1,0.3,1)),box-shadow 160ms var(--ease,cubic-bezier(0.16,1,0.3,1)),transform 160ms var(--ease,cubic-bezier(0.16,1,0.3,1))}.ds-selection-button:hover:not(:disabled){background:#ffffff20}.ds-selection-button:focus-visible{outline:2px solid var(--accent,#287e87);outline-offset:4px}.ds-selection-button:disabled{opacity:.5;cursor:default}:host-context([data-theme=\"dark\"]) .ds-selection{background:#d7ebe7;color:#173d42}@media(prefers-reduced-motion:reduce){.ds-selection-button{transition:none}}"
