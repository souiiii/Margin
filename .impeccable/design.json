      "name": "Recall Card",
      "kind": "card",
      "refersTo": "recall-card",
      "description": "Flat paper for a single recall prompt and its reading-language answer.",
      "html": "<article class=\"ds-recall\"><span class=\"ds-recall-meta\">Expression</span><h2 class=\"ds-recall-term\">in your own words</h2><p class=\"ds-recall-instruction\">Recall the meaning before revealing the answer.</p></article>",
      "css": ".ds-recall{padding:36px;background:var(--paper,#fff);color:var(--text,#28464a);border:1px solid var(--line,#dce3df);border-radius:14px;max-width:590px}.ds-recall-meta{font:400 10px/1.6 var(--ui,\"Inter\",sans-serif);color:var(--muted,#5b6f71)}.ds-recall-term{font:400 35px/1.3 var(--signature,\"Anonymous Pro\",monospace);color:var(--ink,#173d42);margin:26px 0 16px;overflow-wrap:anywhere}.ds-recall-instruction{font:400 12px/1.6 var(--ui,\"Inter\",sans-serif);color:var(--muted,#5b6f71);margin:0 0 30px}"
    },
