  "narrative": {
    "northStar": "The Reading Margin",
    "overview": "Margin is a quiet, daily-use English learning workspace: cool paper, dark teal ink, small practical controls, and enough space to read comfortably. Its visual authority is the user-pinned Mochi and Reader references, interpreted originally in code. The surface contract records the implementation and review provenance.\n\nThree self-hosted families divide the work clearly: Anonymous Pro supplies the signature, Literata carries reading and language examples, and Inter handles dense interface text. Teal guides action, cyan belongs to the bookmark motif, and peach marks language worth keeping. Light and dark themes retain these roles.",
    "keyCharacteristics": [
      "Readable typography with a distinct signature and a dedicated reading face.",
      "Quiet tonal surfaces, hairline divisions, and restrained overlays.",
      "Compact controls beside generous reading and task space.",
      "Peach annotations and a cyan bookmark connect collection with reading."
    ],
    "rules": [
      {
        "name": "The Contextual Color Rule",
        "body": "Use teal for actions and active navigation, peach for selected or collected language and warm emphasis, and cyan for the bookmark motif. Preserve these roles across themes.",
        "section": "colors"
      },
      {
        "name": "The Three Voices Rule",
        "body": "Use only Anonymous Pro for the signature, Literata for reading, and Inter for dense interface text. Do not introduce another display or interface family.",
        "section": "typography"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Keep reading surfaces, lists, and learning cards flat. Reserve diffuse shadows for overlays and the paper motif.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep Anonymous Pro, Literata, and Inter in their established roles.",
      "Do use the matching dark token when the theme changes, including the explicit dark button foregrounds.",
      "Do preserve visible keyboard focus and the reduced-motion override.",
      "Do use peach marks in the reading text and keep annotation controls close to the selected passage.",
      "Do keep lists divided by hairlines and learning cards flat."
    ],
    "donts": [
      "Don't replace the user-specified families with default system display faces or additional fonts.",
      "Don't turn cyan and peach into competing primary action colors.",
      "Don't add decorative elevation to ordinary list rows or learning cards.",
      "Don't use text glyphs in place of the implemented SVG icon vocabulary.",
      "Don't remove reading-size controls or squeeze the notes rail beside prose below the implemented breakpoint."
    ]
  }
}
